  m_Script: {fileID: 11500000, guid: c91d3e95141a6ac4bad6ea23e2c44888, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoCultural
  nomeObjeto: "M\xE1scaras (Fof\xE3o)"
  descricao: "As m\xE1scaras ligadas ao Fof\xE3o representam o folclore maranhense,
    uma figura muito popular no carnaval local. O Fof\xE3o surgiu como personagem
    cultural nas ruas de S\xE3o Lu\xEDs, misturando humor, mist\xE9rio e cr\xEDtica
    social. Ele n\xE3o \xE9 colonial em si, mas representa a continuidade cultural
    da cidade ao longo do tempo. Incluir essas m\xE1scaras no ambiente cria uma ponte
    entre o passado colonial e a cultura popular moderna do Maranh\xE3o."
  raioInteracao: 3
