  m_Script: {fileID: 11500000, guid: c91d3e95141a6ac4bad6ea23e2c44888, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoCultural
  nomeObjeto: Barril
  descricao: "Os barris eram essenciais na S\xE3o Lu\xEDs colonial, usados para armazenar
    e transportar produtos como aguardente, azeite, sal e p\xF3lvora. Por ser uma
    cidade portu\xE1ria, eles chegavam e sa\xEDam constantemente pelos trapiches
    do porto, carregados em navios que faziam rotas entre o Maranh\xE3o, Portugal
    e outras col\xF4nias. Nas ruas e armaz\xE9ns do centro hist\xF3rico, os barris
    eram presen\xE7a constante, simbolizando o intenso com\xE9rcio mar\xEDtimo que
    fez S\xE3o Lu\xEDs prosperar durante os s\xE9culos XVIII e XIX."
  raioInteracao: 3
