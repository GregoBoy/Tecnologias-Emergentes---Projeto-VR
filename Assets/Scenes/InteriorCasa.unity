  m_Script: {fileID: 11500000, guid: c91d3e95141a6ac4bad6ea23e2c44888, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoCultural
  nomeObjeto: "Ba\xFA de madeira colonial"
  descricao: "Os ba\xFAs eram usados para transporte e armazenamento de objetos pessoais,
    documentos e mercadorias valiosas. Em uma cidade portu\xE1ria como S\xE3o Lu\xEDs,
    eles tamb\xE9m faziam parte do fluxo de com\xE9rcio mar\xEDtimo. Muitos viajantes
    e comerciantes traziam ba\xFAs cheios de tecidos, ferramentas e produtos importados
    da Europa. No seu cen\xE1rio, eles ajudam a dar sensa\xE7\xE3o de \"vida humana\"
    e circula\xE7\xE3o de pessoas entre o porto e os armaz\xE9ns."
  raioInteracao: 3
