  m_Script: {fileID: 11500000, guid: c91d3e95141a6ac4bad6ea23e2c44888, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ObjetoCultural
  nomeObjeto: Azulejos portugueses
  descricao: "Os azulejos s\xE3o um dos maiores s\xEDmbolos de S\xE3o Lu\xEDs, heran\xE7a
    direta da coloniza\xE7\xE3o portuguesa nos s\xE9culos XVIII e XIX. Eles foram
    trazidos de Portugal e usados tanto para est\xE9tica quanto para prote\xE7\xE3o
    das paredes contra o calor \xFAmido da regi\xE3o. Em S\xE3o Lu\xEDs, especialmente
    no centro hist\xF3rico, eles criam fachadas inteiras com padr\xF5es azuis e brancos
    que viraram marca registrada da cidade \u2014 por isso ela \xE9 chamada de \"Ilha
    dos Azulejos\"."
  raioInteracao: 3
